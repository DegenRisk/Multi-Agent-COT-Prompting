# Application Configuration
APP_NAME=IntelliDoc Pro
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_KEY_SALT=change-this-to-random-string

# LLM Provider API Keys
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
GOOGLE_API_KEY=your-google-api-key-here

# OCR Service API Keys
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Vector Database Configuration
CHROMADB_HOST=localhost
CHROMADB_PORT=8001
PINECONE_API_KEY=your-pinecone-key
PINECONE_ENVIRONMENT=us-west1-gcp

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/intellidoc
MONGODB_URL=mongodb://localhost:27017/intellidoc

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Document Processing Configuration
MAX_FILE_SIZE_MB=50
SUPPORTED_FORMATS=pdf,png,jpg,jpeg,tiff,docx,xlsx
OCR_ENGINE=aws_textract  # Options: aws_textract, google_documentai, tesseract, multi
EXTRACTION_MODEL=gpt-4-turbo-preview  # Options: gpt-4-turbo-preview, claude-3-opus, gemini-pro

# IRZ-CoT Configuration
ENABLE_ROLE_BASED_PROMPTING=true
ENABLE_ZERO_SHOT_COT=true
CHAIN_OF_THOUGHT_DEPTH=3  # 1-5, higher = more detailed reasoning
CONFIDENCE_THRESHOLD=0.85

# Validation Configuration
ENABLE_RAV=true  # Retrieval-Augmented Validation
ENABLE_RAC=true  # Retrieval-Augmented Correction
VALIDATION_SOURCES=wikipedia,sec_edgar,pubmed,legal_databases
MAX_VALIDATION_ATTEMPTS=3
AUTO_CORRECT_THRESHOLD=0.90

# Performance Configuration
CONCURRENT_PROCESSING_LIMIT=10
PROCESSING_TIMEOUT_SECONDS=300
CACHE_TTL_SECONDS=3600
ENABLE_BATCH_PROCESSING=true

# Security Configuration
JWT_SECRET_KEY=change-this-to-a-secure-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# Monitoring Configuration
ENABLE_PROMETHEUS=true
PROMETHEUS_PORT=9090
ENABLE_STRUCTURED_LOGGING=true

# Storage Configuration
STORAGE_BACKEND=s3  # Options: local, s3, gcs, azure
S3_BUCKET_NAME=intellidoc-documents
GCS_BUCKET_NAME=intellidoc-documents
AZURE_CONTAINER_NAME=intellidoc-documents
LOCAL_STORAGE_PATH=/var/intellidoc/storage

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@intellidoc.ai
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=noreply@intellidoc.ai

# Webhook Configuration
ENABLE_WEBHOOKS=true
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_TIMEOUT_SECONDS=30

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Feature Flags
FEATURE_CUSTOM_MODELS=true
FEATURE_BATCH_UPLOAD=true
FEATURE_REAL_TIME_STREAMING=true
FEATURE_ADVANCED_ANALYTICS=true
